generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP
  FREELANCE
  TEMPORARY
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  SPECIALIST
  LEAD
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EXPIRED
}

enum ApplicationStatus {
  SENT
  VIEWED
  IN_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(CANDIDATE)
  companies    Company[]
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  location    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs        Job[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([name])
}

model Job {
  id             String          @id @default(cuid())
  title          String
  description    String
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location       String?
  workMode       WorkMode
  contractType   ContractType
  seniorityLevel SeniorityLevel
  salaryMin      Int?
  salaryMax      Int?
  currency       String          @default("BRL")
  status         JobStatus       @default(DRAFT)
  publishedAt    DateTime?
  expiresAt      DateTime?
  technologies   JobTechnology[]
  applications   Application[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([workMode])
  @@index([contractType])
  @@index([seniorityLevel])
  @@index([location])
  @@index([createdAt])
}

model Technology {
  id        String          @id @default(cuid())
  name      String          @unique
  jobs      JobTechnology[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([name])
}

model JobTechnology {
  jobId        String
  technologyId String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobId, technologyId])
  @@index([technologyId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SENT)
  coverLetter String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
  @@index([status])
}
